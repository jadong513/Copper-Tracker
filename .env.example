# Copper Price Tracker Configuration

# Flask secret key (change in production!)
SECRET_KEY=your-secret-key-here

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///copper_prices.db

# Metals.dev API Key - FREE 100 requests/month, no credit card required!
# Sign up at: https://metals.dev (free tier)
# Without this key, the app will use demo data
METALS_DEV_API_KEY=your-api-key-here

# Price update interval in minutes
UPDATE_INTERVAL=15

# Fabrication markup percentage for sheet/coil pricing
# Adjust this to match your supplier's actual markup
FABRICATION_MARKUP=35
